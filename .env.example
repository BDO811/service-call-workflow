# Set this once the Cloudflare Worker backend (server/) is deployed, e.g.:
# VITE_SYNC_API_URL=https://service-call-workflow-api.<your-subdomain>.workers.dev
#
# Leave unset to run the app local-only, no email sync UI. The login gate
# still works without this (see VITE_LOCAL_ADMIN_PASSWORD_HASH below) —
# it just checks a password client-side instead of against real accounts.
VITE_SYNC_API_URL=

# SHA-256 hex hash of a password (not the password itself). Generate with:
#   printf '%s' 'your-password' | shasum -a 256 | cut -d' ' -f1
# Gates the app with a single shared password until VITE_SYNC_API_URL is set
# and real per-admin logins take over. Leave unset to disable the gate
# entirely (local dev default — no login prompt at all).
VITE_LOCAL_ADMIN_PASSWORD_HASH=
